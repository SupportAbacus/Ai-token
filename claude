#!/usr/bin/env python3
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from classifier import classify, MODEL_SONNET, MODEL_HAIKU, MODEL_OPUS
from logger import log_session, get_stats, format_stats

_NAMES = {
    'claude-haiku-4-5-20251001': 'Haiku',
    'claude-sonnet-4-6': 'Sonnet',
    'claude-opus-4-8': 'Opus',
}
_WORK = Path.home() / 'claude-work'


def _real_claude() -> str:
    """Return the real claude binary path, not our wrapper."""
    saved = Path.home() / '.cai' / 'real_claude'
    if saved.exists():
        path = saved.read_text().strip()
        if path and Path(path).exists():
            return path
    # Fallback: search PATH, skip ourselves
    our_file = Path(__file__).resolve()
    names = ['claude.cmd', 'claude.exe', 'claude'] if sys.platform == 'win32' else ['claude']
    for d in os.environ.get('PATH', '').split(os.pathsep):
        if not d:
            continue
        for name in names:
            candidate = Path(d) / name
            try:
                if candidate.exists() and candidate.resolve() != our_file:
                    return str(candidate)
            except OSError:
                continue
    return 'claude'


def _exec(cmd: list) -> None:
    """Replace current process with cmd (Unix) or spawn and exit (Windows)."""
    if sys.platform == 'win32':
        import subprocess
        sys.exit(subprocess.run(cmd).returncode)
    else:
        os.execvp(cmd[0], cmd)


def _prompt_interactive_model(project: str) -> str:
    """Ask user to pick a model tier for an interactive session, with 3s timeout."""
    if not sys.stdin.isatty():
        return MODEL_SONNET
    sys.stdout.write(f"→ {project}  Quick[h] / Work[s] / Deep[o]? (Enter=Sonnet, 3s): ")
    sys.stdout.flush()
    if sys.platform == 'win32':
        import msvcrt
        import time as _time
        start = _time.time()
        choice = ''
        while _time.time() - start < 3:
            if msvcrt.kbhit():
                ch = msvcrt.getwche()
                if ch in ('\r', '\n'):
                    sys.stdout.write('\n')
                    break
                choice = ch
                sys.stdout.write('\n')
                break
        else:
            sys.stdout.write('\n')
    else:
        import select as _select
        ready, _, _ = _select.select([sys.stdin], [], [], 3)
        if ready:
            choice = sys.stdin.readline().strip().lower()
        else:
            sys.stdout.write('\n')
            choice = ''
    if choice.startswith('h'):
        return MODEL_HAIKU
    if choice.startswith('o'):
        return MODEL_OPUS
    return MODEL_SONNET


def _detect_project() -> str:
    cwd = Path.cwd()
    try:
        parts = cwd.relative_to(_WORK).parts
        if parts:
            return parts[0]
    except ValueError:
        pass
    return cwd.name


def main():
    args = sys.argv[1:]

    if '--stats' in args:
        print(format_stats(get_stats(7)))
        return

    dry_run = '--dry-run' in args
    if dry_run:
        args = [a for a in args if a != '--dry-run']

    # --model already given → pass through unchanged
    if '--model' in args or '-m' in args:
        if dry_run:
            print("--model already specified — passing through unchanged")
            return
        real = _real_claude()
        _exec([real] + [a for a in sys.argv[1:] if a != '--dry-run'])
        return

    task_parts = [a for a in args if not a.startswith('-')]
    flag_parts = [a for a in args if a.startswith('-')]

    # No task → prompt user for model tier (interactive sessions)
    if not task_parts:
        project = _detect_project()
        if dry_run:
            print(f"→ Sonnet | {project}  (interactive — would prompt h/s/o)")
            return
        model = _prompt_interactive_model(project)
        print(f"→ {_NAMES.get(model, model)} | {project}")
        log_session(model, '(interactive)', project)
        real = _real_claude()
        _exec([real, '--model', model] + args)
        return

    task = ' '.join(task_parts)
    model = classify(task)
    project = _detect_project()
    print(f"→ {_NAMES.get(model, model)} | {project}")

    if dry_run:
        return

    log_session(model, task, project)
    real = _real_claude()
    _exec([real, '--model', model] + flag_parts + task_parts)


if __name__ == '__main__':
    main()
