#!/usr/bin/env python3
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from classifier import classify
from logger import log_session, get_stats, format_stats

_NAMES = {
    'claude-haiku-4-5-20251001': 'Haiku',
    'claude-sonnet-4-6': 'Sonnet',
    'claude-opus-4-8': 'Opus',
}
_MAP = {'haiku': 'claude-haiku-4-5-20251001', 'sonnet': 'claude-sonnet-4-6', 'opus': 'claude-opus-4-8'}
_WORK = Path('/home/rohit-tanwar/claude-work')


def _real_claude() -> str:
    """Return the real claude binary path (not our wrapper)."""
    saved = Path.home() / '.cai' / 'real_claude'
    if saved.exists():
        path = saved.read_text().strip()
        if path and Path(path).exists():
            return path
    # Fallback: search PATH, skip ourselves
    our_file = Path(__file__).resolve()
    for d in os.environ.get('PATH', '').split(':'):
        if not d:
            continue
        candidate = Path(d) / 'claude'
        try:
            if candidate.exists() and candidate.resolve() != our_file:
                return str(candidate)
        except OSError:
            continue
    return 'claude'


def _detect_project() -> str:
    cwd = Path.cwd()
    for base in [_WORK, Path.home() / 'claude-work']:
        try:
            parts = cwd.relative_to(base).parts
            if parts:
                return parts[0]
        except ValueError:
            continue
    return cwd.name


def main():
    args = sys.argv[1:]

    # Our special flags
    if '--stats' in args:
        print(format_stats(get_stats(7)))
        return

    dry_run = '--dry-run' in args
    if dry_run:
        args = [a for a in args if a != '--dry-run']

    # --model already given → pass through unchanged, no routing
    if '--model' in args or '-m' in args:
        if dry_run:
            print("--model already specified — passing through unchanged")
            return
        real = _real_claude()
        os.execvp(real, [real] + [a for a in sys.argv[1:] if a != '--dry-run'])
        return

    # Separate task (positional args) from flags
    task_parts = [a for a in args if not a.startswith('-')]
    flag_parts = [a for a in args if a.startswith('-')]

    # No task → pass through (interactive mode, --help, --version, etc.)
    if not task_parts:
        if dry_run:
            print("No task — would open claude interactively")
            return
        real = _real_claude()
        os.execvp(real, [real] + args)
        return

    # Classify and route
    task = ' '.join(task_parts)
    model = classify(task)
    project = _detect_project()
    print(f"→ {_NAMES.get(model, model)} | {project}")

    if dry_run:
        return

    log_session(model, task, project)
    real = _real_claude()
    os.execvp(real, [real, '--model', model] + flag_parts + task_parts)


if __name__ == '__main__':
    main()
